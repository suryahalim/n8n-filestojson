# Copy to .env and fill with your own secrets (never commit .env)
PIPELINE_DB_PASSWORD=change-me
RABBITMQ_USER=pipeline
RABBITMQ_PASS=change-me
INGEST_ALLOW_DUP=0   # 1 = matikan dedupe sha256 total (testing); 0 = dedupe aktif
OCR_ENGINE=qwen   # default OCR engine when not specified: qwen | tesseract
SETTINGS_PIN=        # optional: gate /settings/ocr POST (empty = open on tailnet)
OCR_AUTO=1   # 1 = flagged docs auto-OCR right after form/batch upload (default engine)
OCR_MAX_PAGES=0   # 0 = OCR every page; positive value = optional cap
MAP_AUTO=0   # 0 = OCR only; no classification, mapping, or delivery
MAP_TIMEOUT=600   # seconds allowed for one mapping LLM call
