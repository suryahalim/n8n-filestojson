{
  "id": "docpipeline-ocr-01",
  "name": "DocPipeline - OCR Scan (Tesseract | Qwen)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ocr-scan",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-ocr",
      "name": "On OCR Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "docpipeline-ocr-01"
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.engine || 'tesseract' }}",
              "rightValue": "qwen",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "options2": {}
        },
        "options": {}
      },
      "id": "if-engine",
      "name": "Engine?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://extractor:5000/documents/{{ $json.body.document_id }}/ocr?engine=qwen",
        "options": {
          "timeout": 900000
        }
      },
      "id": "ocr-qwen",
      "name": "Qwen OCR (extractor)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://extractor:5000/documents/{{ $json.body.document_id }}/ocr?engine=tesseract&lang={{ $json.body.lang || 'eng' }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "ocr-tess",
      "name": "Tesseract OCR (extractor)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$json; r.view='http://100.68.212.36:5000/view/'+r.document_id; return [{json:r}];"
      },
      "id": "fmt-q",
      "name": "Add View Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$json; r.view='http://100.68.212.36:5000/view/'+r.document_id; return [{json:r}];"
      },
      "id": "fmt-t",
      "name": "Add View Link 2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "resp",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        940,
        0
      ]
    }
  ],
  "connections": {
    "On OCR Request": {
      "main": [
        [
          {
            "node": "Engine?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Engine?": {
      "main": [
        [
          {
            "node": "Qwen OCR (extractor)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tesseract OCR (extractor)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Qwen OCR (extractor)": {
      "main": [
        [
          {
            "node": "Add View Link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add View Link": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tesseract OCR (extractor)": {
      "main": [
        [
          {
            "node": "Add View Link 2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add View Link 2": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}