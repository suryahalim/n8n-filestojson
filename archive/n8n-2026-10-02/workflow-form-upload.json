{
  "id": "docpipeline-form-upload",
  "name": "Doc Pipeline - IT Upload Form",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "parameters": {
        "path": "it-upload",
        "formTitle": "IT Document Upload",
        "formDescription": "Upload one or more documents (PDF / Excel / image). Max 10000 files per submission.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Document file",
              "fieldType": "file",
              "requiredField": true,
              "acceptFileTypes": ".pdf,.xlsx,.xls,.csv,.png,.jpg,.jpeg",
              "placeholder": "Select files - max 10000 per submission",
              "multipleFiles": true
            },
            {
              "fieldLabel": "Document type",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Invoice"
                  },
                  {
                    "option": "Purchase Order"
                  },
                  {
                    "option": "Report"
                  },
                  {
                    "option": "SOP / Policy"
                  },
                  {
                    "option": "Other"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Notes",
              "fieldType": "textarea",
              "requiredField": false,
              "placeholder": "Optional context for the receiving system"
            }
          ]
        },
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "form-trigger",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "it-upload-form"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://extractor:5000/documents?doc_type={{ $json.doc_type }}&notes={{ $json.notes }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            }
          ]
        },
        "options": {
          "timeout": 300000,
          "response": {
            "response": {}
          },
          "allowUnauthorizedCerts": false
        }
      },
      "id": "http-extract",
      "name": "Send to Extractor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.summary }}",
        "options": {}
      },
      "id": "respond-done",
      "name": "Respond With Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// one item per uploaded file, streaming path: per-file multipart POST (no base64, no giant JSON body)\nconst it = items[0].json;\nconst label = (it['Document type'] || 'Other').toString().trim().toLowerCase();\nconst MAP = {\"invoice\": \"invoice\", \"purchase order\": \"purchase_order\", \"report\": \"report\", \"sop / policy\": \"sop_policy\", \"other\": \"other\"};\nlet notes = (it['Notes'] || '').toString().replace(/[^A-Za-z0-9._ -]/g, '_').slice(0,200);\nconst out = [];\nfor (const item of items) {\n  const bin = item.binary || {};\n  for (const k of Object.keys(bin).filter(x => /^Document_file/.test(x))) {\n    out.push({ json: { doc_type: MAP[label] || 'other', notes: notes, name: bin[k].fileName || k },\n               binary: { file: bin[k] } });\n  }\n}\nif (!out.length) throw new Error('No files received in the submission');\nreturn out;"
      },
      "id": "normalize",
      "name": "Prepare Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        0
      ],
      "mode": "code"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(x => x.json);\nconst ok = results.filter(r => r && (r.document_id || (r.status && r.status !== 'ERROR')));\nconst err = results.filter(r => !r || r.error || r.status === 'ERROR');\nconst lines = [];\nlines.push(`uploaded: ${ok.length}, failed: ${err.length}, total: ${results.length}`);\nfor (const r of ok.slice(0, 50)) lines.push(`${String(r.document_id||'').slice(0,8)} ${r.status||''} ${r.filename||''}`);\nfor (const r of err.slice(0, 10)) lines.push(`FAIL: ${r.filename||r.error||JSON.stringify(r).slice(0,120)}`);\nif (results.length > 60) lines.push(`...(${results.length} results; check DB /view for full list)`);\nlines.push('auto-OCR queued sequentially (one doc at a time).');\nreturn [{ json: { summary: lines.join('\\n') } }];"
      },
      "id": "summarize-results-1",
      "name": "Summarize Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "On form submission": {
      "main": [
        [
          {
            "node": "Prepare Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Batch": {
      "main": [
        [
          {
            "node": "Send to Extractor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Extractor": {
      "main": [
        [
          {
            "node": "Summarize Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Results": {
      "main": [
        [
          {
            "node": "Respond With Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}